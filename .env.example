# Postgres (used by the synergereader-db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CONNECTION_STRING=postgresql://postgres:postgres@synergereader-db:5432/synergereader

# Ollama — where the backend reaches your local LLM server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama model keep-alive duration. Controls how long Ollama keeps the model loaded in memory.
# Formats: 30s, 30m, 1h (seconds, minutes, hours)
OLLAMA_KEEP_ALIVE=30m

# Google Sign-In — leave both blank to keep the Google button hidden (it only
# renders once a client ID is configured). Get one from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Resend — sends verification and password-reset emails. Leave blank in local
# dev; links print to the backend console instead of being emailed.
EMAIL_KEY=

# Comma-separated emails that get is_admin=1 automatically the moment they
# register (does not affect accounts that already exist).
ADMIN_EMAILS=

# Where the verify-email and reset-password links in emails point back to.
# Must be the real, publicly reachable frontend URL in production.
FRONTEND_URL=http://localhost:3000

# Passed to the frontend build — where the browser reaches the backend API.
REACT_APP_BACKEND_URL=http://localhost:5000

# --- RAG model profiles (I2) -------------------------------------------------
# Read by synerge-reader-backend/rag_model_profiles.py via
# resolve_embedding_profile() / resolve_generation_profile(). These are
# non-secret configuration (model names, dimensions, prefix strings) — never
# put real credentials here. I2 does not wire any of this into main.py or a
# running deployment; a real deployment's values belong at the Compose/
# application configuration boundary, not in this repo file.
#
# Embedding profile: leave every EMBEDDING_* line below commented out to get
# the documented default — ollama / mxbai-embed-large:335m / 1024 dimensions.
# Overrides are all-or-nothing: EMBEDDING_PROVIDER, EMBEDDING_MODEL,
# EMBEDDING_DIMENSION, EMBEDDING_QUERY_PREFIX, and EMBEDDING_DOCUMENT_PREFIX
# must all be set together or not at all — setting only some of them fails
# closed with an error instead of silently mixing default and overridden
# fields. A complete override also requires
# EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h: mandatory acknowledgement
# that the override's query/document prefixes are not yet empirically
# verified against production retrieval quality (pending Phase H).
#
# The example below (nomic-embed-text:v1.5, 768 dimensions) is the current
# schema-compatible explicit-override example — it is NOT the default. Both
# of its prefixes are required (the registry does not invent one for you),
# and the trailing space inside each quoted prefix is load-bearing (it
# separates the prefix from the embedded text), so keep the quotes:
#
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text:v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h
#
# Generation profile: GENERATION_MODEL has no safe universal default and must
# be set explicitly; GENERATION_PROVIDER defaults to "ollama" when unset
# (ollama is currently the only supported generation provider).
#
# GENERATION_PROVIDER=ollama
# GENERATION_MODEL=llama3.1:latest
