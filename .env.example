DB_CONNECTION_STRING=postgresql://postgres:postgres@db:5432/synergereader
# Ollama model keep-alive duration. Controls how long Ollama keeps the model loaded in memory.
# Formats: 30s, 30m, 1h (seconds, minutes, hours)
OLLAMA_KEEP_ALIVE=30m

# --- RAG embedding/generation profile overrides (see rag_model_profiles.py) ---
# These are non-secret model selection keys, not credentials. Production
# values belong in the root Compose-adjacent environment and must be passed
# explicitly by Compose (e.g. via `environment:`/`env_file:` on the service).
# Backend .env files (synerge-reader-backend/.env) are local-development-only;
# rag_model_profiles.py and ollama_embedding_provider.py never call
# load_dotenv() or read a backend .env file themselves.
#
# Leave all five EMBEDDING_* keys below unset to use the documented default
# embedding profile (ollama/mxbai-embed-large:335m, 1024 dimensions). To
# override, set ALL FIVE together plus the acknowledgement flag -- partial
# overrides are rejected on purpose.
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=mxbai-embed-large:335m
# EMBEDDING_DIMENSION=1024
# The trailing space before the closing quote is load-bearing (it separates
# the prefix from the embedded text) -- quoting is required to preserve it
# through dotenv/Compose parsing, which otherwise strip unquoted trailing
# whitespace. Production values belong in the Compose environment, not a
# backend .env file.
# EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h

# Server-controlled, local-only text generation model. GENERATION_MODEL has
# no safe universal default and must be set explicitly if this is wired up.
# GENERATION_PROVIDER=ollama
# GENERATION_MODEL=llama3.1:latest
