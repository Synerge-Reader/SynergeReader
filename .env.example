# Postgres (used by the synergereader-db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CONNECTION_STRING=postgresql://postgres:postgres@synergereader-db:5432/synergereader

# Ollama — where the backend reaches your local LLM server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama model keep-alive duration. Controls how long Ollama keeps the model loaded in memory.
# Formats: 30s, 30m, 1h (seconds, minutes, hours)
OLLAMA_KEEP_ALIVE=30m

# Google Sign-In — leave both blank to keep the Google button hidden (it only
# renders once a client ID is configured). Get one from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Resend — sends verification and password-reset emails. Leave blank in local
# dev; links print to the backend console instead of being emailed.
EMAIL_KEY=

# Comma-separated emails that get is_admin=1 automatically the moment they
# register (does not affect accounts that already exist).
ADMIN_EMAILS=

# Where the verify-email and reset-password links in emails point back to.
# Must be the real, publicly reachable frontend URL in production.
FRONTEND_URL=http://localhost:3000

# Passed to the frontend build — where the browser reaches the backend API.
REACT_APP_BACKEND_URL=http://localhost:5000

# --- RAG model profiles ------------------------------------------------------
# Read by synerge-reader-backend/rag_model_profiles.py via
# resolve_embedding_profile() / resolve_generation_profile(). These are
# non-secret configuration (model names, dimensions, prefix strings) — never
# put real credentials here.
#
# Current wiring status:
#   - main.py resolves the embedding profile at startup, via
#     resolve_embedding_profile(os.environ), and uses it for every embedding
#     call — so the EMBEDDING_* values below do take effect.
#   - docker-compose.yml defines six backend pass-through entries intended to
#     propagate the complete embedding-profile configuration. Actual Compose
#     1.29.2 resolution and propagation, including intentionally empty prefix
#     values, remains unverified and is a release-gate check.
#   - GENERATION_* is foundation-only: main.py does not resolve it, it does
#     not control /ask, generation is still selected through the current
#     request path, and there is no external generation fallback.
#
# Documented default, in effect when every EMBEDDING_* line below is left
# commented out: provider ollama / model mxbai-embed-large:335m /
# dimension 1024.
#
# The last read-only production inventory reported both existing vector columns
# as 768-dimensional. Against that existing deployment, the mxbai/1024 default
# fails closed at startup. Fresh-database vector dimensions are created from the
# resolved expected_dimension; no production schema migration or re-embedding is
# authorized here.
#
# A complete override requires all five keys set together — EMBEDDING_PROVIDER,
# EMBEDDING_MODEL, EMBEDDING_DIMENSION, EMBEDDING_QUERY_PREFIX, and
# EMBEDDING_DOCUMENT_PREFIX. Setting only some of them fails closed with an
# error instead of silently mixing default and overridden fields. A complete
# override also requires EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h:
# mandatory acknowledgement that the override's query/document prefixes are
# not yet empirically verified against production retrieval quality (pending
# Phase H). Intentionally empty prefix values are valid, but only when both
# prefix keys are present.
#
# A matching dimension is not representation compatibility. A 768-dimensional
# profile satisfies the schema's shape; it does not establish that the model
# encodes text the same way as the vectors already stored.
#
# The two Nomic/768 shapes below are mutually exclusive — at most one applies,
# and only after the verification each one names. Neither is the default.
#
# (a) Unprefixed Nomic/768 — both prefix keys intentionally present and empty.
#     A conditional legacy-compatibility candidate only. It stays conditional
#     pending verification of Compose propagation of the resolved values, of
#     the exact model digest / runtime / request behavior, and of the
#     provenance of the surviving stored vectors. The repository shows the
#     legacy application path was unprefixed; it does not establish uniform
#     provenance for the vectors currently in the database.
#
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text:v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h
#
# (b) Prefixed Nomic/768 — the trailing space inside each quoted prefix is
#     load-bearing (it separates the prefix from the embedded text), so keep
#     the quotes. This changes the representation relative to the reported
#     legacy unprefixed corpus, and therefore requires a controlled
#     re-embedding before activation.
#
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text:v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_PROFILE_UNVERIFIED_ACK=pending_phase_h
#
# A controlled re-embedding onto one deliberately chosen profile remains the
# clean long-term path, but it is not the only technically possible startup
# configuration.
#
# None of the examples above authorizes deployment, migration, re-embedding,
# model switching, or a restart.
#
# Generation profile — foundation-only, with no runtime effect until
# generation-profile wiring is implemented. GENERATION_MODEL has no safe
# universal default and must be set explicitly; GENERATION_PROVIDER defaults
# to "ollama" when unset (ollama is currently the only supported generation
# provider). The tag below is a placeholder, not a recommended model.
#
# GENERATION_PROVIDER=ollama
# GENERATION_MODEL=replace-with-approved-local-model-tag
